# Copy to frontend/.env.local for local runs. Do not commit .env.local.
# Direct API (default):
NEXT_PUBLIC_API_URL=http://localhost:8080
# LAN / same-origin: Next rewrites /v1 to local uvicorn. Set:
# NEXT_PUBLIC_API_URL=same-origin
# ALLOWED_DEV_ORIGINS=192.168.0.97
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-betaxed
NEXT_PUBLIC_FIREBASE_API_KEY=fake-api-key
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Optional when not using the Auth emulator:
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com

# Local verbose table (recipe). Next inlines NEXT_PUBLIC_* into the client.
ENV=DEV
VERBOSE=TRUE
NEXT_PUBLIC_ENV=DEV
NEXT_PUBLIC_VERBOSE=TRUE
