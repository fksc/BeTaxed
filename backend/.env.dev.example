# Local development — copy to `.env.dev` (gitignored) or as `.env` for uvicorn/alembic.
#   cp backend/.env.dev.example backend/.env.dev
#   cp backend/.env.dev backend/.env

ENVIRONMENT=DEV
ENV=DEV
VERBOSE=TRUE

DATABASE_URL=postgresql+asyncpg://betaxed:betaxed_dev@localhost:5434/betaxed

CORS_ORIGINS=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000

REDIS_URL=redis://localhost:6381/0

# Contract PDF review (DEV-836). DEV defaults to stub (1-year termo) if unset.
# Live staging review uses Vertex in talent-journey-be. Firebase stays FIREBASE_PROJECT_ID.
# CONTRACT_LLM=stub
# CONTRACT_LLM=gemini
# GOOGLE_CLOUD_PROJECT=talent-journey-be
# VERTEX_LOCATION=europe-west1
# GEMINI_MODEL=gemini-2.5-flash
# Contract jobs. Unset CLOUD_TASKS_TARGET_URL → inline after commit (tests and local DEV).
# Queue betaxed-staging in europe-west1 already exists; do not create another and do not change its retry.
# CLOUD_TASKS_TARGET_URL=https://HOST/internal/workers/review-contract
# CLOUD_TASKS_QUEUE=betaxed-staging
# CLOUD_TASKS_LOCATION=europe-west1
# CLOUD_TASKS_INVOKER_SA=
# CLOUD_TASKS_OIDC_AUDIENCE=
# INTERNAL_JOB_TOKEN=

# Firebase Auth (DEV-829). Local/cloud-agent DEV uses the emulator — no GCP credentials.
FIREBASE_PROJECT_ID=demo-betaxed
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Unset FIREBASE_AUTH_EMULATOR_HOST and set a real project + ADC for staging/prod.

# Platform default success-fee fraction (e.g. 0.30). Unset until billing; commercial_terms overrides per client.
# DEFAULT_FEE_PERCENT=
# STRIPE_SECRET_KEY=       # Checkout + Invoice collection (DEV-842)
# STRIPE_WEBHOOK_SECRET=   # Stripe-Signature HMAC. Not a raw header equality check.

# PII encryption (DEV-830). Local DEV uses built-in dev keys if unset — set unique base64 keys in staging/prod.
# ENCRYPTION_MASTER_KEY=   # base64, 32 bytes — wraps per-company/intake DEKs
# NISS_HMAC_SECRET=        # base64, 32 bytes — per-tenant NISS HMAC

# Invite mail (DEV-852). Unset keys → API returns invite_url for the sender to copy.
# EMAIL_PROVIDER=resend   # or brevo; if unset, first present API key wins
# RESEND_API_KEY=
# BREVO_API_KEY=
# EMAIL_FROM=BeTaxed <noreply@your-domain>
# INVITE_TTL_HOURS=72

# Local ops seed (scripts/reset-local-dev.sh / seed_betaxed_staff.py). DEV + emulator only.
# SEED_STAFF_EMAIL=ops@betaxed.local
# SEED_STAFF_PASSWORD=betaxed-dev

# File storage. Unset GCS_BUCKET → local dir (backend/.local_storage).
# GCS_BUCKET=betaxed-staging-files
# GCS_KMS_KEY_NAME=projects/PROJECT/locations/REGION/keyRings/betaxed/cryptoKeys/gcs-cmek
# LOCAL_STORAGE_DIR=
