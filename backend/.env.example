# Environment templates for BeTaxed backend
#
# Per environment (gitignored — copy from *.example and fill secrets):
#   backend/.env.dev      — local uvicorn + docker-compose Postgres/Redis
#   backend/.env.staging  — GCP staging (Cloud Run env reference)
#   backend/.env.prod     — production
#
# Quick start (local):
#   cp backend/.env.dev.example backend/.env.dev
#   cp backend/.env.dev backend/.env
